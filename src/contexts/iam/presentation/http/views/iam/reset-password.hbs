<h2>Reset password</h2>
<form method="POST" action="/reset-password">
  {{> csrf}}
  <input type="hidden" name="selector" value="{{selector}}">
  <input type="hidden" name="verifier" value="{{verifier}}">
  <label>New password <input type="password" name="newPassword" value=""></label>
  {{#if errors.newPassword}}<span class="err">{{errors.newPassword}}</span>{{/if}}
  {{#if errors.form}}<span class="err">{{errors.form}}</span>{{/if}}
  <button type="submit">Reset password</button>
</form>