NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://blog:blog@localhost:5432/blog?schema=public
SESSION_SECRET=change-me-to-a-long-random-string-min-16-chars
REDIS_URL=redis://localhost:6379
# Storage. STORAGE_DRIVER=local uses the local-disk adapter and ignores S3_*.
# For dev Garage: run `docker compose up garage`, then copy S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY from docker/garage/credentials.env into your .env.
STORAGE_DRIVER=local
STORAGE_MAX_BYTES=5242880
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=blog-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE=http://localhost:3900/blog-media
S3_FORCE_PATH_STYLE=true
# CSP img-src follows S3_PUBLIC_BASE when STORAGE_DRIVER=s3.
STORAGE_LOCAL_DIR=./.storage
# Rate limiting (seconds). Register/resend/reset TTLs are fixed at 1h in code.
RATE_LIMIT_GLOBAL_TTL=15
RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_LOGIN_TTL=900
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_RESEND_LIMIT=3
RATE_LIMIT_RESET_LIMIT=5
# Proxy hops to trust for X-Forwarded-For (0=off). Set to your proxy count in production
# so per-IP rate limiting uses the real client IP instead of the proxy's IP.
TRUST_PROXY=0
# Mail (Plan 7c). MAIL_DRIVER=log sends nothing (dev default); set smtp in production.
# For dev Mailpit: run `docker compose up mailpit`, then set SMTP_HOST=localhost SMTP_PORT=1025.
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=no-reply@localhost
APP_URL=http://localhost:3000
