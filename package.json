{
  "name": "blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "db:generate": "prisma generate --schema src/infrastructure/persistence/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/infrastructure/persistence/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema src/infrastructure/persistence/prisma/schema.prisma",
    "postinstall": "prisma generate --schema src/infrastructure/persistence/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express-handlebars": "^9.0.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-handlebars": "^5.3.1",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.0",
    "globals": "^14.0.0",
    "jest": "^29.7.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "tsc-alias": "^1.8.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
